      message =>
        message.author.id === client.user.id &&
        message.embeds.length > 0 &&
        message.embeds[0].title === "✦ HALO AI"
    );

    if (existingPanel) {
      await existingPanel.edit({
        embeds: [createPanelEmbed()],
        components: createPanelComponents()
      });

